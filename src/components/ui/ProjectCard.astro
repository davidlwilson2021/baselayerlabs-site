---
interface Props {
  title: string;
  tagline: string;
  status: 'live' | 'development' | 'acquired';
  stack: string[];
  slug: string;
  url?: string;
}

const { title, tagline, status, stack, slug, url } = Astro.props;

const statusConfig = {
  live:        { label: 'Live',        color: 'hsl(142 70% 45%)' },
  development: { label: 'In Dev',      color: 'hsl(39 46% 61%)' },
  acquired:    { label: 'Acquired',    color: 'hsl(220 70% 55%)' },
} as const;

const badge = statusConfig[status];
---

<article
  class="relative border p-8 md:p-10 flex flex-col group transition-all duration-300 cursor-pointer"
  style="background-color: var(--color-card); border-color: var(--color-border);"
>
  <!-- Animated border glow on hover -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style="box-shadow: inset 0 0 0 1px hsl(39 46% 61% / 0.4);"
  ></div>

  <!-- Status badge -->
  <div class="flex items-center gap-2 mb-6">
    <div class="w-1.5 h-1.5 rounded-full" style={`background-color: ${badge.color};`}></div>
    <span class="text-xs font-medium uppercase tracking-widest" style={`color: ${badge.color};`}>
      {badge.label}
    </span>
  </div>

  <!-- Title + tagline -->
  <h3 class="text-2xl font-display font-medium mb-3" style="color: var(--color-foreground);">{title}</h3>
  <p class="text-sm font-light leading-relaxed flex-1 mb-8" style="color: var(--color-muted-foreground);">{tagline}</p>

  <!-- Stack tags -->
  <div class="flex flex-wrap gap-2 mb-8">
    {stack.slice(0, 4).map((tag) => (
      <span
        class="text-[11px] font-mono px-2 py-1 border"
        style="border-color: var(--color-border); color: var(--color-muted-foreground);"
      >
        {tag}
      </span>
    ))}
  </div>

  <!-- Links -->
  <div class="flex items-center gap-4">
    <a
      href={`/projects/${slug}`}
      class="text-sm font-medium inline-flex items-center gap-2 transition-colors hover:text-[var(--color-primary)]"
      style="color: var(--color-foreground);"
    >
      Case Study
      <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
    {url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm transition-colors hover:text-[var(--color-primary)] inline-flex items-center gap-1"
        style="color: var(--color-muted-foreground);"
      >
        Live
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M7 17L17 7M17 7H7M17 7v10"/>
        </svg>
      </a>
    )}
  </div>
</article>
