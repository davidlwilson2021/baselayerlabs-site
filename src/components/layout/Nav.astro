---
const navLinks = [
  { name: 'Product',    href: '/#product' },
  { name: 'Technology', href: '/#technology' },
  { name: 'Company',    href: '/#company' },
];

const isHome = Astro.url.pathname === '/';
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 py-6 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="relative z-10 flex items-center gap-2 group">
      <div
        class="w-6 h-6 border-2 rotate-45 transition-transform duration-500 ease-out group-hover:rotate-90"
        style="border-color: var(--color-primary);"
      ></div>
      <span class="font-semibold text-lg tracking-wide" style="color: var(--color-foreground);">
        BASE LAYER
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium transition-colors relative group"
          style="color: var(--color-muted-foreground);"
        >
          {link.name}
          <span
            class="absolute -bottom-1 left-0 w-0 h-px transition-all duration-300 group-hover:w-full"
            style="background-color: var(--color-primary);"
          ></span>
        </a>
      ))}
      <a
        href="/#contact"
        class="ml-4 px-5 py-2 text-[11px] font-medium uppercase tracking-wider border transition-all duration-300"
        style="color: var(--color-primary); border-color: var(--color-primary);"
        onmouseover="this.style.backgroundColor='var(--color-primary)';this.style.color='var(--color-primary-foreground)'"
        onmouseout="this.style.backgroundColor='transparent';this.style.color='var(--color-primary)'"
      >
        Contact
      </a>
    </nav>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      class="md:hidden relative z-10 p-2"
      style="color: var(--color-foreground);"
      aria-label="Toggle menu"
    >
      <svg id="icon-menu" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="absolute top-full left-0 right-0 border-b shadow-xl md:hidden flex flex-col p-6 gap-6 opacity-0 -translate-y-4 pointer-events-none transition-all duration-200"
    style="background-color: var(--color-background); border-color: var(--color-border);"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="text-lg font-medium transition-colors"
        style="color: var(--color-foreground);"
      >
        {link.name}
      </a>
    ))}
    <a
      href="/#contact"
      class="mt-4 px-6 py-3 text-center text-sm font-medium uppercase tracking-wider border transition-all duration-300"
      style="color: var(--color-primary); border-color: var(--color-primary);"
    >
      Contact Us
    </a>
  </div>
</header>

<script>
  const header   = document.getElementById('site-nav')!;
  const toggle   = document.getElementById('nav-toggle')!;
  const menu     = document.getElementById('mobile-menu')!;
  const iconMenu  = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  // Scroll → frosted-glass header
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.style.cssText += ';background-color:hsl(0 0% 4% / 0.85);backdrop-filter:blur(12px);padding-top:1rem;padding-bottom:1rem;border-bottom:1px solid hsl(0 0% 16%)';
    } else {
      header.style.backgroundColor = '';
      header.style.backdropFilter = '';
      header.style.paddingTop = '1.5rem';
      header.style.paddingBottom = '1.5rem';
      header.style.borderBottom = '';
    }
  }, { passive: true });

  // Mobile toggle
  let open = false;
  toggle.addEventListener('click', () => {
    open = !open;
    if (open) {
      menu.style.opacity = '1';
      menu.style.transform = 'translateY(0)';
      menu.style.pointerEvents = 'auto';
      iconMenu.classList.add('hidden');
      iconClose.classList.remove('hidden');
    } else {
      menu.style.opacity = '0';
      menu.style.transform = 'translateY(-1rem)';
      menu.style.pointerEvents = 'none';
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
    }
  });

  // Close mobile menu on link click
  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      open = false;
      menu.style.opacity = '0';
      menu.style.transform = 'translateY(-1rem)';
      menu.style.pointerEvents = 'none';
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });
</script>
