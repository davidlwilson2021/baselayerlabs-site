---
const year = new Date().getFullYear();

const surface = [
  { name: 'Capabilities', href: '/#product' },
  { name: 'Proof',        href: '/proof' },
  { name: 'Technology',   href: '/#technology' },
  { name: 'Studio',       href: '/#company' },
  { name: 'Contact',      href: '/#contact' },
];

const connect = [
  { name: 'GitHub',          href: 'https://github.com/davidlwilson2021', external: true },
  { name: 'LinkedIn',        href: 'https://www.linkedin.com/in/davidwilson78', external: true },
  { name: 'GhostStack',      href: 'https://ghoststack.pages.dev/', external: true },
  { name: 'GhostStack Repo', href: 'https://github.com/davidlwilson2021/ghoststack', external: true },
  { name: 'TradeFolio Repo', href: 'https://github.com/davidlwilson2021/tradefolio-beta-app', external: true },
  { name: 'Email',           href: 'mailto:greyhawkdiesel@gmail.com', external: false },
];
---

<footer class="border-t pt-16 pb-8" style="background-color: var(--color-background); border-color: var(--color-border);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8 mb-16">

      <!-- Brand -->
      <div class="col-span-1 md:col-span-2">
        <a href="/" class="inline-flex items-center gap-2 group mb-6">
          <div
            class="w-5 h-5 border-2 rotate-45 transition-transform duration-500 ease-out group-hover:rotate-90"
            style="border-color: var(--color-primary);"
          ></div>
          <span class="font-display font-semibold tracking-wide" style="color: var(--color-foreground);">
            BASE LAYER LABS
          </span>
        </a>
        <p class="text-sm font-light max-w-sm" style="color: var(--color-muted-foreground);">
          An engineering studio architecting full-stack platforms and applied data systems. Strict correctness, zero compromise.
        </p>
      </div>

      <!-- Surface links -->
      <div>
        <h4 class="font-medium uppercase tracking-widest text-xs mb-6" style="color: var(--color-foreground);">Surface</h4>
        <ul class="space-y-4">
          {surface.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm transition-colors hover:text-[var(--color-primary)]"
                style="color: var(--color-muted-foreground);"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect links -->
      <div>
        <h4 class="font-medium uppercase tracking-widest text-xs mb-6" style="color: var(--color-foreground);">Connect</h4>
        <ul class="space-y-4">
          {connect.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-sm transition-colors hover:text-[var(--color-primary)] inline-flex items-center gap-1"
                style="color: var(--color-muted-foreground);"
              >
                {link.name}
                {link.external && (
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" d="M7 17L17 7M17 7H7M17 7v10" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t pt-8 flex flex-col md:flex-row justify-between items-center gap-4" style="border-color: var(--color-border);">
      <p class="text-xs" style="color: var(--color-muted-foreground);">
        &copy; {year} Base Layer Labs &mdash; Dave Wilson. All rights reserved.
      </p>
      <a
        href="#"
        class="text-xs transition-colors hover:text-[var(--color-foreground)]"
        style="color: var(--color-muted-foreground);"
      >
        Back to Top
      </a>
    </div>

  </div>
</footer>
