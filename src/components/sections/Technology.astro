---
const metrics = [
  { value: 'First',        label: 'Principles' },
  { value: 'MS \'26',      label: 'Data Science' },
  { value: 'Solo',         label: 'Operating Model' },
  { value: 'End-to-End',   label: 'Type Safety' },
];
---

<section id="technology" class="py-32 relative overflow-hidden">
  <!-- Decorative top/bottom lines -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(to right, transparent, var(--color-border), transparent);"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(to right, transparent, var(--color-border), transparent);"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: copy -->
      <div>
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-8" style="background-color: var(--color-primary);"></div>
          <span class="text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-primary);">Core Technology</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-display font-light mb-8 leading-tight" style="color: var(--color-foreground);">
          Owning the <br />
          <span class="font-semibold italic">Full Stack,</span> from schema to surface.
        </h2>
        <div class="space-y-6 font-light leading-relaxed" style="color: var(--color-muted-foreground);">
          <p>
            Most engineering teams pay an invisible tax on integration debt &mdash; the friction between
            mismatched data models, hand-rolled validation, and contracts that drift over time.
          </p>
          <p>
            We design PostgreSQL schemas, GraphQL and REST contracts, validation layers, and mobile clients
            as one continuous system. Drizzle, Zod, NestJS, and React Native, wired together so the types
            flow end to end.
          </p>
        </div>
      </div>

      <!-- Right: metrics grid -->
      <div class="grid grid-cols-2 gap-4">
        {metrics.map((metric) => (
          <div
            class="border p-8 flex flex-col justify-center relative overflow-hidden group cursor-default"
            style="border-color: var(--color-border); background-color: hsl(0 0% 7% / 0.3);"
          >
            <div
              class="absolute inset-0 transition-transform duration-500 ease-out translate-y-full group-hover:translate-y-0"
              style="background-color: hsl(39 46% 61% / 0.05);"
            ></div>
            <span class="relative z-10 text-3xl md:text-4xl font-display font-medium mb-2" style="color: var(--color-primary);">{metric.value}</span>
            <span class="relative z-10 text-sm font-medium uppercase tracking-widest" style="color: var(--color-muted-foreground);">{metric.label}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
