---
---

<section id="hero" class="relative min-h-screen flex items-center pt-20 overflow-hidden">

  <!-- Dot-grid background -->
  <div class="absolute inset-0 z-0 pointer-events-none border-grid opacity-30"></div>

  <!-- Decorative vertical line -->
  <div
    class="absolute left-[10%] md:left-[15%] top-0 bottom-0 w-px hidden md:block"
    style="background: linear-gradient(to bottom, transparent, var(--color-border), transparent); opacity: 0.5;"
  ></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <div class="lg:col-span-8">

        <!-- Kicker -->
        <div class="flex items-center gap-4 mb-8 fade-up">
          <div class="h-px w-12" style="background-color: var(--color-primary);"></div>
          <span class="text-sm font-medium uppercase tracking-[0.2em]" style="color: var(--color-primary);">
            Next-Gen Infrastructure
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-display font-light leading-[1.05] tracking-tight text-balance mb-8 fade-up fade-up-delay-1" style="color: var(--color-foreground);">
          The foundational <br class="hidden md:block" />
          <span class="font-semibold">layer</span> for
          <span class="italic font-light" style="color: var(--color-primary);">progress.</span>
        </h1>

        <!-- Subline -->
        <p class="text-lg md:text-xl font-light leading-relaxed mb-12 max-w-2xl fade-up fade-up-delay-2" style="color: var(--color-muted-foreground);">
          An engineering studio architecting full-stack platforms and applied data systems.
          Currently building GhostStack &mdash; a serverless productivity stack that converts
          ad-hoc work-call notes into structured end-of-day reports.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 fade-up fade-up-delay-3">
          <a
            href="/#contact"
            class="group inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-medium transition-all duration-300"
            style="background-color: var(--color-primary); color: var(--color-primary-foreground);"
          >
            Get Started
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" d="M5 12h14m-7-7 7 7-7 7"/>
            </svg>
          </a>
          <a
            href="/#product"
            class="inline-flex items-center justify-center px-8 py-4 text-sm font-medium border transition-all duration-300 hover:opacity-80"
            style="color: var(--color-foreground); border-color: var(--color-border);"
          >
            Explore Technology
          </a>
        </div>
      </div>

      <!-- Right: Spinning geometric accent -->
      <div class="lg:col-span-4 hidden lg:flex justify-center relative fade-up fade-up-delay-4">
        <div class="relative w-64 h-64">
          <div
            class="absolute inset-0 rotate-45"
            style="border: 1px solid hsl(39 46% 61% / 0.3); animation: spinCw 40s linear infinite; transform-origin: center;"
          ></div>
          <div
            class="absolute inset-4 rotate-12"
            style="border: 1px solid hsl(0 0% 16% / 0.8); animation: spinCcw 50s linear infinite; transform-origin: center;"
          ></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-2 h-2 rounded-full" style="background-color: var(--color-primary); box-shadow: 0 0 20px var(--color-primary);"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
