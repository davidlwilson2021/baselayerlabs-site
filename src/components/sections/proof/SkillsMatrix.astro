---
const columns = [
  {
    title: 'Languages',
    items: ['R', 'Python', 'SQL', 'TypeScript'],
  },
  {
    title: 'Backend & API',
    items: ['NestJS', 'GraphQL', 'PostgreSQL', 'Hono'],
  },
  {
    title: 'Infra & AI',
    items: ['Cloudflare Workers', 'D1', 'React Native', 'Expo', 'MLOps'],
  },
];
---

<section id="skills" class="py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="h-px w-8" style="background-color: var(--color-primary);"></div>
        <span class="text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-primary);">Skills Matrix</span>
      </div>
      <h2 class="text-4xl md:text-5xl font-display font-light" style="color: var(--color-foreground);">
        Tools across the <span class="font-semibold" style="color: var(--color-primary);">full stack.</span>
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {columns.map((col) => (
        <div class="border p-8" style="border-color: var(--color-border); background-color: var(--color-card);">
          <h3 class="text-xs font-medium uppercase tracking-widest mb-6" style="color: var(--color-primary);">{col.title}</h3>
          <div class="flex flex-wrap gap-2">
            {col.items.map((item) => (
              <span
                class="text-[11px] font-mono px-2 py-1 border"
                style="border-color: var(--color-border); color: var(--color-foreground);"
              >
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
