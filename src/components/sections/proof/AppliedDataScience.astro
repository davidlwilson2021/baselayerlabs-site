---
---

<section id="applied-data" class="py-24 border-b" style="border-color: var(--color-border);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-8" style="background-color: var(--color-primary);"></div>
          <span class="text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-primary);">Applied Data Science</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-display font-light mb-6" style="color: var(--color-foreground);">
          Multi-model R pipeline — <span class="font-semibold" style="color: var(--color-primary);">100/100.</span>
        </h2>
        <p class="text-base font-light leading-relaxed mb-8" style="color: var(--color-muted-foreground);">
          glm, rpart, nnet, and tm in one reproducible workflow. Sanitized neural-net prediction table
          from credit risk classification — public-safe, no answer keys.
        </p>
        <a
          href="/projects/wk6-r-pipeline"
          class="inline-flex items-center gap-2 text-sm font-medium transition-colors hover:text-[var(--color-primary)]"
          style="color: var(--color-foreground);"
        >
          Full case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M5 12h14m-7-7 7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="border p-4" style="border-color: var(--color-border); background-color: var(--color-card);">
        <img
          src="/proof/wk6-predictions.svg"
          alt="Neural network credit risk prediction table — sanitized sample from Week 6 R pipeline"
          class="w-full h-auto"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
