---
const tiles = [
  { value: 'Live', label: 'GhostStack', sub: 'Edge serverless product', accent: true },
  { value: 'In Dev', label: 'TradeFolio', sub: 'Full-stack mobile platform', accent: false },
  { value: '100/100', label: 'R Pipeline', sub: 'Multi-model validation', accent: true },
  { value: "MS '26", label: 'Data Science', sub: '7/12 courses · 6× A', accent: false },
];
---

<section id="impact" class="py-20 border-b" style="border-color: var(--color-border);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center gap-4 mb-10">
      <div class="h-px w-8" style="background-color: var(--color-primary);"></div>
      <span class="text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-primary);">Impact at a glance</span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {tiles.map((tile) => (
        <div
          class="border p-6 md:p-8 flex flex-col relative overflow-hidden group"
          style={`border-color: var(--color-border); background-color: ${tile.accent ? 'hsl(0 0% 7% / 0.5)' : 'hsl(0 0% 7% / 0.3)'};`}
        >
          <span class="text-2xl md:text-3xl font-display font-medium mb-1" style="color: var(--color-primary);">{tile.value}</span>
          <span class="text-sm font-medium mb-1" style="color: var(--color-foreground);">{tile.label}</span>
          <span class="text-xs font-light" style="color: var(--color-muted-foreground);">{tile.sub}</span>
        </div>
      ))}
    </div>
  </div>
</section>
